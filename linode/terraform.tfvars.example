# Copy to  terraform.tfvars  (gitignored) and fill in your token. Terraform
# auto-loads terraform.tfvars, so `terraform plan` picks these up with no flags.
#
# Terraform GENERATES the SSH keypair for you (linode/id_esp32crack), so you do
# not need to supply a key. The only value you must set is the token; the rest
# have sensible defaults - but check the region offers GPU plans and the plan
# id is valid for your account.

# REQUIRED. https://cloud.linode.com/profile/tokens (Linodes + Firewalls R/W).
linode_token = "PASTE_YOUR_TOKEN_HERE"

# GPU plan. Default g2-gpu-rtx4000a1-s (RTX 4000 Ada x1) is the cheapest and
# suits most cases. List plans without a CLI (public API), in PowerShell:
#   (irm https://api.linode.com/v4/linode/types).data | ? { $_.class -eq 'gpu' } | ft id,label
# gpu_type = "g2-gpu-rtx4000a1-s"

# Region must offer GPU plans; us-ord (default) does. To list them:
#   (irm https://api.linode.com/v4/regions).data | ? { $_.capabilities -contains 'GPU Linodes' } | ft id,label
# region = "us-ord"

# Lock SSH to your own IP - find it with: curl -s ifconfig.me
# allowed_ssh_cidr = "203.0.113.7/32"

# Pull the multi-GB weakpass list on boot (adds several minutes to provisioning)
# fetch_weakpass = false

# Extra keys to authorise IN ADDITION to the generated one (usually leave empty)
# authorized_keys = ["ssh-ed25519 AAAA... you@host"]
